{
  "name": "shortcut-hero",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test app/analytics/client.test.ts app/api/request.test.ts app/game/session.test.ts app/persistence/round-payload.test.ts app/platform/launch-compatibility.test.ts app/referrals/client.test.ts app/security/headers.test.ts app/site-config.test.ts app/tools/registry.test.ts",
    "test:render": "NEXT_PUBLIC_SITE_URL= npm run build && node --test tests/rendered-html.test.mjs",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:render && npm run test:browser",
    "check": "npm run lint && npm run typecheck && npm test",
    "catalog:import": "tsx scripts/import-shortcut-catalog.ts",
    "db:generate": "drizzle-kit generate",
    "social-card": "node scripts/capture-social-card.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "posthog-js": "^1.404.1",
    "postprocessing": "^6.39.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.1",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.14"
    }
  },
  "type": "module"
}
