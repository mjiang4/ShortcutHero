# Analytics stays disabled unless both values are set in a production build.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Keep replay off until the privacy decision gate is approved.
NEXT_PUBLIC_POSTHOG_REPLAY_ENABLED=false
NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE_RATE=0.05

# Set this to the deployed commit SHA for sanitized error grouping.
NEXT_PUBLIC_APP_RELEASE=
