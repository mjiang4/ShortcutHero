# Analytics stays disabled unless both values are set in a production build.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Keep replay off until the privacy decision gate is approved.
NEXT_PUBLIC_POSTHOG_REPLAY_ENABLED=false
NEXT_PUBLIC_POSTHOG_REPLAY_SAMPLE_RATE=0.05

# Set this to the deployed commit SHA for sanitized error grouping.
NEXT_PUBLIC_APP_RELEASE=

# Set this before launch so previews and alternate deployment hosts use one URL.
NEXT_PUBLIC_SITE_URL=

# Server-only origin of the existing Sites persistence API. Keep that deployment
# running; never point this at the Vercel frontend or deploy the frontend over it.
# Leave empty locally to avoid writing test rounds to the live database.
SHORTCUT_HERO_BACKEND_ORIGIN=
